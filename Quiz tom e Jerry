      <ellipse cx="103" cy="10" rx="3.5" ry="5" fill="#f5b7b7" transform="rotate(15 103 10)"/>
      <!-- Olhos -->
      <ellipse cx="91" cy="25" rx="4.5" ry="5.5" fill="#fff" stroke="#111" stroke-width="2"/>
      <ellipse cx="102" cy="24" rx="4.5" ry="5.5" fill="#fff" stroke="#111" stroke-width="2"/>
      <circle cx="92" cy="26" r="2.3" fill="#111"/>
      <circle cx="103" cy="25" r="2.3" fill="#111"/>
      <!-- Focinho -->
      <ellipse cx="98" cy="34" rx="6" ry="4" fill="#f5d6a8" stroke="#111" stroke-width="2"/>
      <circle cx="98" cy="32" r="2" fill="#111"/>
      <!-- Sorriso -->
      <path d="M93 37 Q98 42 103 37" stroke="#111" stroke-width="2" fill="none" stroke-linecap="round"/>
      <!-- Bigodes -->
      <line x1="104" y1="32" x2="116" y2="29" stroke="#111" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="104" y1="35" x2="117" y2="35" stroke="#111" stroke-width="1.8" stroke-linecap="round"/>
      <line x1="104" y1="38" x2="116" y2="41" stroke="#111" stroke-width="1.8" stroke-linecap="round"/>
      <!-- Braços correndo -->
      <path d="M40 34 Q25 26 18 36" stroke="#111" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <path d="M42 48 Q28 56 20 50" stroke="#111" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <!-- Pernas correndo -->
      <path d="M34 58 Q26 66 18 62" stroke="#111" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <path d="M46 58 Q44 68 52 66" stroke="#111" stroke-width="4.5" fill="none" stroke-linecap="round"/>
      <!-- Rabo -->
      <path d="M26 40 Q10 34 4 22" stroke="#c68642" stroke-width="5" fill="none" stroke-linecap="round"/>
      <path d="M26 40 Q10 34 4 22" stroke="#111" stroke-width="1.8" fill="none" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- ===== CONTAINER DO QUIZ ===== -->
  <div class="quiz-wrapper">
    <div class="quiz-card" id="quizCard">

      <!-- Cabeçalho com personagens -->
      <div class="header-characters">
        <div class="character-box tom-box" aria-hidden="true">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <!-- Tom gato -->
            <ellipse cx="50" cy="58" rx="30" ry="26" fill="#6d8fb5" stroke="#111" stroke-width="4"/>
            <!-- Orelhas -->
            <polygon points="28,38 22,10 44,26" fill="#6d8fb5" stroke="#111" stroke-width="4" stroke-linejoin="round"/>
            <polygon points="72,38 78,10 56,26" fill="#6d8fb5" stroke="#111" stroke-width="4" stroke-linejoin="round"/>
            <polygon points="29,34 26,17 40,27" fill="#f5b7b7"/>
            <polygon points="71,34 74,17 60,27" fill="#f5b7b7"/>
            <!-- Olhos -->
            <ellipse cx="39" cy="52" rx="9" ry="11" fill="#fff" stroke="#111" stroke-width="3"/>
            <ellipse cx="61" cy="52" rx="9" ry="11" fill="#fff" stroke="#111" stroke-width="3"/>
            <ellipse cx="41" cy="53" rx="4.5" ry="6" fill="#111"/>
            <ellipse cx="59" cy="53" rx="4.5" ry="6" fill="#111"/>
            <circle cx="43" cy="50" r="1.8" fill="#fff"/>
            <circle cx="61" cy="50" r="1.8" fill="#fff"/>
            <!-- Sobrancelhas -->
            <path d="M30 42 Q39 36 48 42" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
            <path d="M70 42 Q61 36 52 42" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round"/>
            <!-- Focinho -->
            <ellipse cx="50" cy="66" rx="14" ry="9" fill="#f5d6a8" stroke="#111" stroke-width="3"/>
            <ellipse cx="50" cy="62" rx="5" ry="3.5" fill="#e88a8a" stroke="#111" stroke-width="2"/>
            <path d="M50 66 L50 72" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <path d="M42 72 Q50 78 58 72" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <!-- Bigodes -->
            <line x1="34" y1="64" x2="14" y2="58" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="34" y1="69" x2="13" y2="69" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="66" y1="64" x2="86" y2="58" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="66" y1="69" x2="87" y2="69" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <!-- Sorriso maroto -->
            <path d="M38 76 Q50 86 62 76" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          </svg>
        </div>

        <div class="title-area">
          <h1 class="main-title">Tom &amp; Jerry</h1>
          <p class="subtitle">🐭 QUIZ MALUCO 🐱</p>
        </div>

        <div class="character-box" aria-hidden="true">
          <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
            <!-- Jerry rato -->
            <circle cx="50" cy="52" r="30" fill="#c68642" stroke="#111" stroke-width="4"/>
            <!-- Orelhas -->
            <ellipse cx="26" cy="26" rx="14" ry="17" fill="#c68642" stroke="#111" stroke-width="4" transform="rotate(-20 26 26)"/>
            <ellipse cx="74" cy="26" rx="14" ry="17" fill="#c68642" stroke="#111" stroke-width="4" transform="rotate(20 74 26)"/>
            <ellipse cx="28" cy="28" rx="7" ry="9" fill="#f5b7b7" transform="rotate(-20 28 28)"/>
            <ellipse cx="72" cy="28" rx="7" ry="9" fill="#f5b7b7" transform="rotate(20 72 28)"/>
            <!-- Olhos -->
            <ellipse cx="40" cy="48" rx="8" ry="10" fill="#fff" stroke="#111" stroke-width="3"/>
            <ellipse cx="60" cy="48" rx="8" ry="10" fill="#fff" stroke="#111" stroke-width="3"/>
            <circle cx="42" cy="50" r="4" fill="#111"/>
            <circle cx="58" cy="50" r="4" fill="#111"/>
            <circle cx="43" cy="48" r="1.5" fill="#fff"/>
            <circle cx="59" cy="48" r="1.5" fill="#fff"/>
            <!-- Focinho -->
            <ellipse cx="50" cy="66" rx="12" ry="8" fill="#f5d6a8" stroke="#111" stroke-width="3"/>
            <ellipse cx="50" cy="63" rx="4" ry="3" fill="#111"/>
            <!-- Sorriso -->
            <path d="M42 70 Q50 78 58 70" stroke="#111" stroke-width="2.5" fill="none" stroke-linecap="round"/>
            <!-- Bigodes -->
            <line x1="34" y1="62" x2="14" y2="56" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="34" y1="67" x2="13" y2="67" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="66" y1="62" x2="86" y2="56" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
            <line x1="66" y1="67" x2="87" y2="67" stroke="#111" stroke-width="2.5" stroke-linecap="round"/>
          </svg>
        </div>
      </div>

      <!-- Barra de status -->
      <div class="status-bar">
        <div class="timer">
          <span class="timer-icon">⏱️</span>
          <span id="timerDisplay">0:00</span>
        </div>
        <div class="question-counter">
          <span class="counter-icon">📋</span>
          <span id="counterDisplay">1/5</span>
        </div>
      </div>

      <!-- Área da pergunta / resultados -->
      <div class="question-area" id="questionArea">
        <!-- Conteúdo dinâmico via JS -->
      </div>

    </div>
  </div>

  <script>
    (function() {
      'use strict';

      // ========== DADOS DO QUIZ ==========
      const QUESTIONS = [
        {
          question: "Qual é o nome da gata pela qual o Tom tenta chamar atenção?",
          options: ["Toodles Galore", "Mamãe Dois Sapatos", "Juju", "Fifi"],
          correct: 0
        },
        {
          question: "Qual é o nome do buldogue que costuma bater no Tom?",
          options: ["Tyke", "Spike", "Butch", "Rex"],
          correct: 1
        },
        {
          question: "Qual é o nome do ratinho sobrinho/amigo de fraldinha do Jerry?",
          options: ["Muscles", "Tuffy / Nibbles", "Quacker", "Tuxedo"],
          correct: 1
        },
        {
          question: "Qual é o nome da dona humana do Tom que raramente mostra o rosto?",
          options: ["Mamãe Dois Sapatos", "Dona Célia", "Mamãe Joana", "Sra. Jones"],
          correct: 0
        },
        {
          question: "Qual é a comida favorita do Jerry que aparece em quase todo episódio?",
          options: ["Queijo", "Leite", "Bolo", "Maçã"],
          correct: 0
        }
      ];

      // ========== ESTADO DO JOGO ==========
      let currentQuestionIndex = 0;
      let correctCount = 0;
      let wrongCount = 0;
      let timerInterval = null;
      let secondsElapsed = 0;
      let quizFinished = false;
      let answerLocked = false;
      let transitionTimeout = null;

      // ========== ELEMENTOS DO DOM ==========
      const questionArea = document.getElementById('questionArea');
      const timerDisplay = document.getElementById('timerDisplay');
      const counterDisplay = document.getElementById('counterDisplay');
      const quizCard = document.getElementById('quizCard');

      // ========== FUNÇÕES DO TIMER ==========
      function formatTime(totalSeconds) {
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${seconds.toString().padStart(2, '0')}`;
      }

      function startTimer() {
        stopTimer();
        secondsElapsed = 0;
        timerDisplay.textContent = formatTime(0);
        timerInterval = setInterval(() => {
          secondsElapsed++;
          timerDisplay.textContent = formatTime(secondsElapsed);
        }, 1000);
      }

      function stopTimer() {
        if (timerInterval) {
          clearInterval(timerInterval);
          timerInterval = null;
        }
      }

      // ========== RENDERIZAÇÃO ==========
      function renderQuestion() {
        if (transitionTimeout) {
          clearTimeout(transitionTimeout);
          transitionTimeout = null;
        }

        const q = QUESTIONS[currentQuestionIndex];
        counterDisplay.textContent = `${currentQuestionIndex + 1}/${QUESTIONS.length}`;
        answerLocked = false;

        // Constrói o HTML da pergunta
        const screen = document.createElement('div');
        screen.className = 'question-screen';

        const questionText = document.createElement('div');
        questionText.className = 'question-text';
        questionText.textContent = q.question;

        const optionsGrid = document.createElement('div');
        optionsGrid.className = 'options-grid';

        q.options.forEach((optionText, index) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'option-btn';
          btn.textContent = optionText;
          btn.dataset.index = index;
          btn.addEventListener('click', () => handleAnswer(index, btn));
          optionsGrid.appendChild(btn);
        });

        screen.appendChild(questionText);
        screen.appendChild(optionsGrid);

        questionArea.innerHTML = '';
        questionArea.appendChild(screen);
      }

      // ========== LÓGICA DE RESPOSTA ==========
      function handleAnswer(selectedIndex, selectedBtn) {
        if (answerLocked || quizFinished) return;
        answerLocked = true;

        const q = QUESTIONS[currentQuestionIndex];
        const isCorrect = selectedIndex === q.correct;

        // Desabilita todos os botões
        const allButtons = questionArea.querySelectorAll('.option-btn');
        allButtons.forEach(btn => { btn.disabled = true; });

        // Marca visualmente a resposta correta
        const correctBtn = allButtons[q.correct];
        correctBtn.classList.add('correct');
        correctBtn.innerHTML = `${correctBtn.textContent}<span class="feedback-icon">✅</span>`;

        if (isCorrect) {
          correctCount++;
        } else {
          wrongCount++;
          selectedBtn.classList.add('wrong');
          selectedBtn.innerHTML = `${selectedBtn.textContent}<span class="feedback-icon">❌</span>`;
        }

        // Animação de saída e próxima pergunta
        const screen = questionArea.querySelector('.question-screen');
        if (screen) {
          screen.classList.add('slide-out');
        }

        const delay = isCorrect ? 700 : 1000;

        transitionTimeout = setTimeout(() => {
          currentQuestionIndex++;

          if (currentQuestionIndex < QUESTIONS.length) {
            renderQuestion();
          } else {
            finishQuiz();
          }
          transitionTimeout = null;
        }, delay);
      }

      // ========== TELA DE RESULTADOS ==========
      function finishQuiz() {
        quizFinished = true;
        stopTimer();

        counterDisplay.textContent = `${QUESTIONS.length}/${QUESTIONS.length}`;

        const totalQuestions = QUESTIONS.length;
        const percentage = Math.round((correctCount / totalQuestions) * 100);
        let message = '';
        let emoji = '';

        if (percentage === 100) {
          message = 'PERFEITO! Você é um mestre dos desenhos!';
          emoji = '🏆';
        } else if (percentage >= 80) {
          message = 'Muito bem! Você conhece Tom e Jerry!';
          emoji = '🎉';
        } else if (percentage >= 60) {
          message = 'Nada mal! Mas ainda dá pra melhorar!';
          emoji = '👍';
        } else if (percentage >= 40) {
          message = 'Hmm... Hora de reassistir aos clássicos!';
          emoji = '🤔';
        } else {
          message = 'Ops! Jerry fugiu com suas respostas!';
          emoji = '😅';
        }

        const resultsScreen = document.createElement('div');
        resultsScreen.className = 'results-screen';

        resultsScreen.innerHTML = `
          <div class="trophy">${emoji}</div>
          <h2 class="results-title">FIM DE JOGO!</h2>
          <p style="font-weight:700; font-size:1.05rem; color:#2a5298; margin: -2px 0 8px;">${message}</p>
          <div class="stats-grid">
            <div class="stat-box acertos">
              <span class="stat-value">${correctCount}</span>
              <span class="stat-label">Acertos</span>
            </div>
            <div class="stat-box erros">
              <span class="stat-value">${wrongCount}</span>
              <span class="stat-label">Erros</span>
            </div>
            <div class="stat-box">
              <span class="stat-value">${formatTime(secondsElapsed)}</span>
              <span class="stat-label">Tempo</span>
            </div>
          </div>
          <button type="button" class="play-again-btn" id="playAgainBtn">JOGAR NOVAMENTE</button>
        `;

        questionArea.innerHTML = '';
        questionArea.appendChild(resultsScreen);

        // Evento do botão jogar novamente
        const playAgainBtn = document.getElementById('playAgainBtn');
        playAgainBtn.addEventListener('click', resetQuiz);
      }

      // ========== REINICIAR QUIZ ==========
      function resetQuiz() {
        // Reseta estado
        currentQuestionIndex = 0;
        correctCount = 0;
        wrongCount = 0;
        quizFinished = false;
        answerLocked = false;
        secondsElapsed = 0;

        if (transitionTimeout) {
          clearTimeout(transitionTimeout);
          transitionTimeout = null;
        }

        // Reinicia timer
        startTimer();

        // Animação de reinício no card
        quizCard.style.animation = 'none';
        void quizCard.offsetHeight; // força reflow
        quizCard.style.animation = 'cardPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both';

        // Renderiza primeira pergunta
        renderQuestion();
      }

      // ========== INICIALIZAÇÃO ==========
      function init() {
        resetQuiz();
      }

      // Inicia quando o DOM estiver pronto
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }

    })();
  </script>
</body>
</html>
