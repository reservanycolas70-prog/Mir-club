<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tom & Jerry Quiz 🐱🐭</title>
  <!-- Fontes divertidas -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Luckiest+Guy&family=Fredoka:wght@400;600;700&display=swap" rel="stylesheet">
  <style>
    /* ========== RESET & BASE ========== */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Fredoka', sans-serif;
      background: #1e3c72; /* azul forte clássico */
      background: radial-gradient(circle at 20% 30%, #2a5298, #0f1e3d);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow-x: hidden;
      position: relative;
      padding: 12px;
      color: #1a1a1a;
    }

    /* ========== FUNDO COM PADRÃO DE QUEIJO ========== */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: 
        radial-gradient(circle at 10% 20%, #ffd966 3px, transparent 3px),
        radial-gradient(circle at 90% 70%, #ffd966 3px, transparent 3px),
        radial-gradient(circle at 40% 80%, #ffe599 4px, transparent 4px);
      background-size: 80px 80px, 120px 120px, 150px 150px;
      opacity: 0.18;
      pointer-events: none;
      z-index: 0;
    }

    /* ========== JERRY CORRENDO (efeito especial obrigatório) ========== */
    .jerry-runner {
      position: fixed;
      bottom: 6px;
      left: -140px;
      width: 110px;
      height: 60px;
      z-index: 999;
      pointer-events: none;
      animation: jerrySprint 9s linear infinite;
      filter: drop-shadow(0 6px 4px rgba(0,0,0,0.3));
    }

    .jerry-runner svg {
      width: 100%;
      height: 100%;
      animation: jerryBounce 0.25s infinite alternate ease-in-out;
    }

    @keyframes jerrySprint {
      0%   { left: -140px; transform: scaleX(1); }
      45%  { left: 100%; transform: scaleX(1); }
      50%  { left: 100%; transform: scaleX(-1); } /* vira */
      95%  { left: -140px; transform: scaleX(-1); }
      100% { left: -140px; transform: scaleX(1); }
    }

    @keyframes jerryBounce {
      from { transform: translateY(0px) rotate(-3deg); }
      to   { transform: translateY(-8px) rotate(3deg); }
    }

    /* ========== CONTAINER PRINCIPAL ========== */
    .quiz-wrapper {
      width: 100%;
      max-width: 800px;
      position: relative;
      z-index: 2;
    }

    .quiz-card {
      background: #fff8e7;
      border: 6px solid #111;
      border-radius: 36px;
      box-shadow: 14px 14px 0 #111, 0 0 0 6px #ffd966;
      padding: 24px 22px 30px;
      position: relative;
      overflow: hidden;
      animation: cardPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      min-height: 430px;
      display: flex;
      flex-direction: column;
    }

    @keyframes cardPop {
      0%   { transform: scale(0.7) rotate(-2deg); opacity: 0; }
      70%  { transform: scale(1.03) rotate(1deg); }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }

    /* ========== CABEÇALHO COM TOM E JERRY ========== */
    .header-characters {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin-bottom: 6px;
      padding: 0 6px;
      position: relative;
    }

    .character-box {
      width: 92px;
      height: 92px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: transform 0.3s ease;
    }

    .character-box:hover {
      transform: scale(1.15) rotate(-4deg);
    }

    .character-box.tom-box:hover {
      transform: scale(1.15) rotate(4deg);
    }

    .character-box svg {
      width: 100%;
      height: 100%;
      filter: drop-shadow(3px 4px 0 rgba(0,0,0,0.25));
    }

    .title-area {
      text-align: center;
      flex: 1;
      padding-bottom: 4px;
    }

    .main-title {
      font-family: 'Luckiest Guy', cursive;
      font-size: clamp(1.7rem, 6vw, 2.7rem);
      line-height: 1;
      color: #ffcc00;
      -webkit-text-stroke: 3px #111;
      text-shadow: 4px 4px 0 #c0392b, 8px 8px 0 rgba(0,0,0,0.15);
      letter-spacing: 1px;
      animation: titleWiggle 3s infinite ease-in-out;
      transform-origin: center;
    }

    @keyframes titleWiggle {
      0%, 100% { transform: rotate(-1deg) scale(1); }
      50%      { transform: rotate(1.5deg) scale(1.03); }
    }

    .subtitle {
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      font-size: 0.95rem;
      color: #b03a2e;
      letter-spacing: 1px;
      margin-top: 2px;
    }

    /* ========== BARRA DE STATUS (TIMER + PROGRESSO) ========== */
    .status-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      background: #2a5298;
      border: 4px solid #111;
      border-radius: 999px;
      padding: 8px 18px;
      margin: 10px 0 16px;
      box-shadow: 4px 4px 0 #111;
      color: #fff;
      font-weight: 700;
    }

    .timer, .question-counter {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: clamp(0.9rem, 2.5vw, 1.1rem);
    }

    .timer span, .question-counter span {
      background: #ffcc00;
      color: #111;
      padding: 3px 10px;
      border-radius: 999px;
      border: 2px solid #111;
      font-family: 'Luckiest Guy', cursive;
      font-size: 1.15rem;
      min-width: 68px;
      text-align: center;
      display: inline-block;
      line-height: 1.2;
    }

    .timer-icon, .counter-icon {
      font-size: 1.2rem;
    }

    /* ========== ÁREA DA PERGUNTA ========== */
    .question-area {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .question-screen {
      animation: questionSlideIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes questionSlideIn {
      0%   { opacity: 0; transform: translateY(30px) scale(0.95); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    .question-screen.slide-out {
      animation: questionSlideOut 0.35s ease-in forwards;
    }

    @keyframes questionSlideOut {
      0%   { opacity: 1; transform: translateY(0) scale(1); }
      100% { opacity: 0; transform: translateY(-28px) scale(0.96); }
    }

    .question-text {
      background: #ffffff;
      border: 5px solid #111;
      border-radius: 24px;
      padding: 18px 20px;
      margin-bottom: 20px;
      box-shadow: 6px 6px 0 #ffcc00;
      font-weight: 700;
      font-size: clamp(1.05rem, 3.1vw, 1.35rem);
      text-align: center;
      line-height: 1.35;
      color: #111;
      position: relative;
      transition: transform 0.3s ease;
    }

    .question-text:hover {
      transform: translateY(-2px) rotate(-0.5deg);
    }

    /* ========== BOTÕES DE RESPOSTA ========== */
    .options-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }

    .option-btn {
      background: #ffd966;
      border: 4px solid #111;
      border-radius: 22px;
      padding: 16px 14px;
      font-family: 'Fredoka', sans-serif;
      font-weight: 700;
      font-size: clamp(0.92rem, 2.8vw, 1.1rem);
      color: #111;
      cursor: pointer;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.2s;
      box-shadow: 5px 5px 0 #111;
      text-align: center;
      line-height: 1.25;
      position: relative;
      overflow: hidden;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .option-btn:hover:not(:disabled) {
      background: #ffe9a8;
      transform: translate(-3px, -3px) rotate(-1deg) scale(1.02);
      box-shadow: 8px 8px 0 #111;
    }

    .option-btn:active:not(:disabled) {
      transform: translate(2px, 2px) scale(0.97);
      box-shadow: 2px 2px 0 #111;
    }

    .option-btn:disabled {
      cursor: default;
      opacity: 0.85;
    }

    /* Feedback de resposta */
    .option-btn.correct {
      background: #7bd88f !important;
      border-color: #1b5e20;
      color: #0a2e0f;
      animation: correctPop 0.5s ease;
    }

    .option-btn.wrong {
      background: #f28b82 !important;
      border-color: #b71c1c;
      color: #3a0505;
      animation: wrongShake 0.5s ease;
    }

    @keyframes correctPop {
      0%   { transform: scale(1); }
      45%  { transform: scale(1.1) rotate(2deg); }
      100% { transform: scale(1); }
    }

    @keyframes wrongShake {
      0%, 100% { transform: translateX(0); }
      20%      { transform: translateX(-9px); }
      40%      { transform: translateX(9px); }
      60%      { transform: translateX(-5px); }
      80%      { transform: translateX(5px); }
    }

    .option-btn .feedback-icon {
      position: absolute;
      right: 10px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 1.4rem;
      animation: popIn 0.4s ease;
    }

    @keyframes popIn {
      0%   { opacity: 0; transform: translateY(-50%) scale(0); }
      60%  { opacity: 1; transform: translateY(-50%) scale(1.3); }
      100% { opacity: 1; transform: translateY(-50%) scale(1); }
    }

    /* ========== TELA DE RESULTADOS ========== */
    .results-screen {
      text-align: center;
      animation: resultPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 8px 0;
    }

    @keyframes resultPop {
      0%   { transform: scale(0.7) rotate(-3deg); opacity: 0; }
      70%  { transform: scale(1.04) rotate(1deg); }
      100% { transform: scale(1) rotate(0); opacity: 1; }
    }

    .results-title {
      font-family: 'Luckiest Guy', cursive;
      font-size: clamp(1.8rem, 6vw, 2.6rem);
      color: #ffcc00;
      -webkit-text-stroke: 3px #111;
      text-shadow: 4px 4px 0 #c0392b;
      margin-bottom: 6px;
    }

    .trophy {
      font-size: 3.2rem;
      animation: trophyBounce 1.1s infinite ease-in-out alternate;
      line-height: 1;
    }

    @keyframes trophyBounce {
      from { transform: translateY(0) scale(1) rotate(-5deg); }
      to   { transform: translateY(-12px) scale(1.1) rotate(5deg); }
    }

    .stats-grid {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px;
      margin: 10px 0 16px;
      width: 100%;
    }

    .stat-box {
      background: #2a5298;
      border: 4px solid #111;
      border-radius: 20px;
      padding: 12px 22px;
      box-shadow: 5px 5px 0 #111;
      color: #fff;
      font-weight: 700;
      min-width: 110px;
      transition: transform 0.2s;
    }

    .stat-box:hover {
      transform: translateY(-4px) scale(1.04);
    }

    .stat-box .stat-value {
      font-family: 'Luckiest Guy', cursive;
      font-size: 1.9rem;
      display: block;
      color: #ffcc00;
      line-height: 1.1;
      text-shadow: 2px 2px 0 #111;
    }

    .stat-box .stat-label {
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.7px;
    }

    .stat-box.acertos .stat-value { color: #7bd88f; }
    .stat-box.erros .stat-value   { color: #f28b82; }

    .play-again-btn {
      background: #ffcc00;
      border: 5px solid #111;
      border-radius: 999px;
      padding: 16px 44px;
      font-family: 'Luckiest Guy', cursive;
      font-size: clamp(1.2rem, 4vw, 1.7rem);
      color: #111;
      cursor: pointer;
      box-shadow: 7px 7px 0 #111;
      transition: transform 0.12s ease, box-shadow 0.12s ease, background 0.2s;
      margin-top: 6px;
      letter-spacing: 1px;
      animation: btnPulse 1.6s infinite ease-in-out;
    }

    @keyframes btnPulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.05); }
    }

    .play-again-btn:hover {
      background: #ffe9a8;
      transform: translate(-4px, -4px) rotate(-2deg) scale(1.05);
      box-shadow: 11px 11px 0 #111;
      animation-play-state: paused;
    }

    .play-again-btn:active {
      transform: translate(2px, 2px) scale(0.97);
      box-shadow: 3px 3px 0 #111;
    }

    /* ========== RESPONSIVIDADE ========== */
    @media (max-width: 560px) {
      .quiz-card {
        padding: 18px 14px 24px;
        border-width: 5px;
        border-radius: 28px;
        box-shadow: 10px 10px 0 #111, 0 0 0 5px #ffd966;
      }
      .options-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      .option-btn {
        padding: 14px 10px;
      }
      .character-box {
        width: 66px;
        height: 66px;
      }
      .status-bar {
        padding: 6px 12px;
        gap: 6px;
      }
      .timer span, .question-counter span {
        font-size: 1rem;
        min-width: 58px;
        padding: 2px 8px;
      }
      .jerry-runner {
        width: 80px;
        height: 44px;
      }
      .stat-box {
        padding: 10px 16px;
        min-width: 92px;
      }
      .stat-box .stat-value {
        font-size: 1.6rem;
      }
    }

    @media (max-width: 380px) {
      .header-characters {
        flex-wrap: wrap;
      }
      .character-box {
        width: 56px;
        height: 56px;
      }
      .title-area {
        order: -1;
        width: 100%;
        flex: none;
      }
    }
  </style>
</head>
<body>

  <!-- ===== JERRY CORRENDO (efeito especial) ===== -->
  <div class="jerry-runner" aria-hidden="true">
    <svg viewBox="0 0 120 70" xmlns="http://www.w3.org/2000/svg">
      <!-- Corpo do Jerry -->
      <ellipse cx="60" cy="42" rx="34" ry="20" fill="#c68642" stroke="#111" stroke-width="3.5"/>
      <!-- Barriga -->
      <ellipse cx="60" cy="46" rx="22" ry="13" fill="#f5d6a8" stroke="#111" stroke-width="2.5"/>
      <!-- Cabeça -->
      <circle cx="94" cy="28" r="19" fill="#c68642" stroke="#111" stroke-width="3.5"/>
      <!-- Orelhas -->
      <ellipse cx="86" cy="10" rx="9" ry="11" fill="#c68642" stroke="#111" stroke-width="3" transform="rotate(-25 86 10)"/>
